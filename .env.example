# Environment configuration — copy to .env and fill in (never commit .env)

# --- LLM provider ---------------------------------------------------------------
# One of: openai | gemini | groq. Provider, model, key and timeout all come
# from here — nothing is hardcoded in the source.
LLM_PROVIDER=openai

# --- OpenAI (GPT-4o by default) --------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=60

# --- Google Gemini (2.0 Flash by default) -----------------------------------------
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=60

# --- Groq (Llama 3.3 70B by default) ----------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=60

# --- LLM retry policy ---------------------------------------------------------------
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE=1.0

# --- Audio intake limits ---------------------------------------------------------------
CC_MAX_AUDIO_MB=50
CC_MAX_AUDIO_MIN=60

# --- Transcription -----------------------------------------------------------------------
# tiny|base|small|medium|large-v3 — tiny keeps the Docker image and downloads small.
CC_WHISPER_MODEL=tiny
# auto|cuda|cpu — auto uses CUDA float16 when available, else CPU int8.
CC_WHISPER_DEVICE=auto
# Set to 0 to skip model preload at startup (useful for fast UI-only testing).
CC_PRELOAD_MODEL=1

# --- Persistence ----------------------------------------------------------------------------
CC_DB_PATH=data/calls.db
CC_REPORTS_DIR=reports

# --- App ------------------------------------------------------------------------------------------------
CC_HOST=0.0.0.0
CC_PORT=7860

# --- Observability -------------------------------------------------------------------------------------------
# Set to enable the LangSmith status indicator in the Observability tab.
LANGSMITH_API_KEY=
