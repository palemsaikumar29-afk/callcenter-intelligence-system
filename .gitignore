# Secrets & local config — never commit keys
.env
*.env

# Runtime artifacts — never commit databases, reports, or model weights
data/
reports/
*.db
*.db-journal
models/
~/.cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
test_data/__pycache__/
.coverage
.ruff_cache/

# Gradio
*.pem

# Tests / OS
.pytest_cache/
.DS_Store

# Large audio (keep committed samples tiny; generate the rest locally)
*.mp3
*.m4a
*.flac
!test_data/*.wav
